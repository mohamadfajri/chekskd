# Supabase (bring your own project - the app reads these at build/runtime)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co

# Server-only key for admin imports. Never prefix this with VITE.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp bot number in international format WITHOUT +, e.g. 6281234567890
VITE_WHATSAPP_BOT_NUMBER=6281234567890

# Shared secret used by Hermes when calling POST /api/wa-result.
# Generate a long random value and configure the same value in Hermes.
HERMES_API_SECRET=replace-with-a-long-random-secret

# Optional canonical HTTPS origin used in image_url returned to Hermes.
# On Vercel set this to the production domain, e.g. https://chekskd.vercel.app
PUBLIC_APP_URL=https://your-production-domain.example

# Admin page. Server-only; never prefix with VITE.
ADMIN_PASSWORD=changeme

# Optional source folder used by the Supabase Storage upload script.
SKD_PDF_DIR=C:\path\to\FILE SKD 2024
