# Supabase (bring your own project — the app reads these at build/runtime)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp bot number in international format WITHOUT +, e.g. 6281234567890
VITE_WHATSAPP_BOT_NUMBER=6281234567890

# Admin page (client-side gate — for MVP only, replace with real auth later)
VITE_ADMIN_PASSWORD=changeme
