# Public SKD web application. Do not add a trailing slash.
SKD_APP_URL=https://chekskd.vercel.app
HERMES_API_SECRET=replace-with-the-same-secret-used-by-vercel

# WhatsApp Business app via Linked Devices (QR/Baileys).
# The login session is stored under data/whatsapp/session and must stay secret.
# WHATSAPP_ENABLED=true is added by `hermes whatsapp` after pairing succeeds.
WHATSAPP_MODE=bot
WHATSAPP_DM_POLICY=open
WHATSAPP_ALLOWED_USERS=*
WHATSAPP_ALLOW_ALL_USERS=true
WHATSAPP_GROUP_POLICY=disabled
WHATSAPP_SEND_READ_RECEIPTS=false
WHATSAPP_REPLY_PREFIX=

# Private Telegram channel for the owner. Keep the real token and user ID only
# in data/.env on the VPS.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_USERS=replace-with-owner-numeric-user-id
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_HOME_CHANNEL=replace-with-owner-numeric-user-id
TELEGRAM_HOME_CHANNEL_NAME=Owner
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=false
HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT=5
HERMES_TELEGRAM_INIT_TIMEOUT=10

# SumoPod OpenAI-compatible inference endpoint.
OPENAI_BASE_URL=https://ai.sumopod.com/v1
OPENAI_API_KEY=replace-with-sumopod-api-key
SKD_AI_EXPLANATION_ENABLED=true
SKD_AI_MODEL=deepseek-v4-flash

# Dashboard is published only on VPS localhost and reached through an SSH tunnel.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=replace-with-owner-username
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-long-random-signing-secret
